# Copy to `.env` and edit. `.env` holds a secret and must not be committed.

# Where events are delivered. Use https:// as soon as the server has a certificate.
COLLECTOR_URL=http://collector.example.com/api/alpr/events

# The shared secret nginx checks on the server (X-Collector-Token).
COLLECTOR_TOKEN=put-the-shared-secret-here

# Local SQLite database. It holds every event, so keep it on storage that survives
# reboots, and back it up.
PI_DB_PATH=pi_data/pi_events.db

# Where nginx forwards the cameras' POSTs to (see deploy/nginx-pi.conf). Keep it on
# loopback: the endpoint has no authentication. Use 127.0.0.1, not "localhost",
# which can resolve to IPv6 while nginx connects over IPv4.
PI_LISTEN_ADDR=127.0.0.1:3000

# Optional tuning (defaults shown).
# REQUEST_TIMEOUT_SECS=60
# BACKOFF_CAP_SECS=300
# MAX_CAMERA_BODY_BYTES=67108864
